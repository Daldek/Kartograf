 <head><meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
.accordioni {
  background-color: #ddd;
  color: #444;
  cursor: pointer;
  padding: 10px;
  border: none;
  text-align: left;
  outline: none;
  font-size: 11px;
  transition: 0.4s;
  width: 236px;
  font-family: Verdana,Arial,Helvetica,sans-serif;
 
}

.active, .accordioni:hover {
  background-color: #ccc;
}

.accordioni:after {
  content: '\002B';
  color: #777;
  font-weight: bold;
  float: right;
  margin-left: 5px;
}

.active:after {
  content: "\2212";
}

.panel {
  padding: 0 18px;
  background-color: white;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.2s ease-out;
    width: 200px;
	margin-top: 2px;
	margin-bottom: 5px;
}


ul, ol, li, h1, h2, h3, h4, h5, h6, pre, form, fieldset, input, p, blockquote, th, td {
		margin: 0;
		padding: 0;
		font-family: Verdana,Arial,Helvetica,sans-serif;
}

p {
	font-size: 11px;

}
	
.gwt-HTML {

	
	font-size: 10px;
	border-collapse: separate;
    border-spacing: 2px;
	color: black;
	direction: ltr;
	font-family: Verdana,Arial,Helvetica,sans-serif;
}

img {
		max-width: 16px;
		max-height: 16px;
		border: 0;
	}

.item-ico {
	margin: 8px 8px 0 8px;
	float: left;

}

.resultR {
    left: 0;
    height: 2.5em;
   line-height: normal;
   position: relative;
   padding: 0;
}

.item-label {
    color: #333;
    line-height: 12px;
	float: left;
    margin: 9px 0 0 0;
    width: 190px;
    font-size: 9px;
    font-weight: normal;

}
b {
 
	color: #000;
	float: left;
    width: 190px;
    font-size: 11px;
    font-weight: bold;
	display: block;
    position: absolute;
    left: 0;
    right: 0;
    padding-right: 2em;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;

}
.item-content {
	padding: 8px 0 0 32px;
	clear: both;
    color: #000;
	font-size: 10px;
}

.item-fieldname {
    clear: both;
    color: #333;
	font-size: 10px;
    display: block;
    float: left;
    width: 190px;
	font-family: Verdana,Arial,Helvetica,sans-serif;
}

.item-fieldvalue {
    color: #000;
    font-weight: bold;
	display: block;
    float: left;
    width: 190px;
	font-size: 10px;
	font-family: Verdana,Arial,Helvetica,sans-serif;

}

.item-fielddesc {
    display: block;
    float: left;
    width: 190px;
    margin: 0 0 8px 0;
    padding: 0 8px 4px 0;
    color: #aaa;
    font-size: 9px;
    border-bottom: 1px solid #aaa;
}
.wordwrap {
            word-wrap: break-word;
            word-break: break-all;
}




</style>
<script>


function compare(a, b) {
  //alert (1);
  const arkuszA = a.aktualnosc;
  const arkuszB = b.aktualnosc;

  let comparison = 0;
  if (arkuszA > arkuszB) {
    comparison = 1;
  } else if (arkuszA < arkuszB) {
    comparison = -1;
  }
  return comparison * -1;
}

function createTable (skor_NMT_wg_akt) {



	skor_NMT_wg_akt.sort( compare );
	console.log(skor_NMT_wg_akt.sort(compare));
	
	var textCustom, fLen, icustom;

	fLen = skor_NMT_wg_akt.length;

	textCustom = "";
		for (icustom = 0; icustom < fLen; icustom++) {
		  
		  textCustom += "<button class='accordioni'>" + skor_NMT_wg_akt[icustom].godlo + " " + skor_NMT_wg_akt[icustom].aktualnoscRok  + " " + skor_NMT_wg_akt[icustom].charakterystykaPrzestrzenna + "</button><div class='panel'>";
		  textCustom += "<span class='item-fieldvalue wordwrap' title='Pobierz plik'><a href='"+ skor_NMT_wg_akt[icustom].url+"'>Pobierz plik danych dla tej sekcji</a><br/></span><span class='item-fielddesc'></span>"
		  textCustom += "<span class='item-fieldname'>Godło</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].godlo+"'>"+skor_NMT_wg_akt[icustom].godlo+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Aktualność</span><span class='item-fieldvalue' title='"+ skor_NMT_wg_akt[icustom].aktualnosc +"'>" + skor_NMT_wg_akt[icustom].aktualnosc + "</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Format</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].format+"'>"+skor_NMT_wg_akt[icustom].format+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Charakterystyka przestrzenna</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].charakterystykaPrzestrzenna+"'>"+skor_NMT_wg_akt[icustom].charakterystykaPrzestrzenna+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Błąd średni wysokości</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].bladSredniWysokosci+"'>"+skor_NMT_wg_akt[icustom].bladSredniWysokosci+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Błąd średni położenia</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].bladSredniPolozenia+"'>"+skor_NMT_wg_akt[icustom].bladSredniPolozenia+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Układ współrzędnych poziomych</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].ukladWspolrzednychPoziomych+"'>"+skor_NMT_wg_akt[icustom].ukladWspolrzednychPoziomych+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Układ współrzędnych pionowych</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].ukladWspolrzednychPionowych+"'>"+skor_NMT_wg_akt[icustom].ukladWspolrzednychPionowych+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Cały arkusz wypełniony treścią</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].calyArkuszWypelnionyTrescia+"'>"+skor_NMT_wg_akt[icustom].calyArkuszWypelnionyTrescia+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Moduł archiwizacji</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].modulArchiwizacji+"'>"+skor_NMT_wg_akt[icustom].modulArchiwizacji+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Numer zgłoszenia pracy</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].numerZgloszeniaPracy+"'>"+skor_NMT_wg_akt[icustom].numerZgloszeniaPracy+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Źródło danych</span><span class='item-fieldvalue' title='"+skor_NMT_wg_akt[icustom].zrDanych+"'>"+skor_NMT_wg_akt[icustom].zrDanych+"</span><span class='item-fielddesc'></span>";
		  textCustom += "<span class='item-fieldname'>Data włączenia do PZGiK</span><span class='item-fieldvalue' title='"+ skor_NMT_wg_akt[icustom].dt_pzgik +"'>" + skor_NMT_wg_akt[icustom].dt_pzgik + "</span><span class='item-fielddesc'></span>";
		  textCustom += "</div>";
		}

return textCustom;

}


</script>

</head>
<body>
<!-- <p>Kliknij w celu rozwinięcia zawartości.</p> -->






<div id="listOfObjectsAkt2" style="width: 256px; margin-bottom: 3px;"></div>
<div id="listOfObjects2" style="width: 256px; margin-bottom: 3px;"></div>

<script>
var skor_NMT_wg_akt = [];



skor_NMT_wg_akt.push({url:"https://opendata.geoportal.gov.pl/NumDaneWys/NMT/76625/76625_1257614_N-33-48-C-a-3-4.asc",godlo:"N-33-48-C-a-3-4", aktualnosc:"2022-04-28", format:"ARC/INFO ASCII GRID", charakterystykaPrzestrzenna:"1.00 m", bladSredniWysokosci:"0.15", bladSredniPolozenia:"0.30", ukladWspolrzednychPoziomych:"PL-1992", ukladWspolrzednychPionowych:"PL-EVRF2007-NH", calyArkuszWypelnionyTrescia:"TAK", modulArchiwizacji:"1:5000", numerZgloszeniaPracy:"GI-FOTO.6202.10.2022", aktualnoscRok:"2022", zrDanych:"Skaning laserowy", dt_pzgik:"2022-12-16"});



if (skor_NMT_wg_akt[0].aktualnoscRok>0) {
  document.getElementById("listOfObjectsAkt2").innerHTML = "<p>Aktualność 2023 i starsze</p>";
  document.getElementById("listOfObjects2").innerHTML = createTable(skor_NMT_wg_akt);
  } 
  else 	{

		document.getElementById("listOfObjects2").innerHTML = "<p>Dane z warstwy '2023 i starsze' możliwe do pobrania w skali 1:250 000 lub większych</p><br>";

	}

</script>




<script>
var acc = document.getElementsByClassName("accordioni");
var customValue;
console.log(acc.length);

for (customValue = 0; customValue < acc.length; customValue++) {
	console.log(customValue);
  acc[customValue].addEventListener("click", function() {
    this.classList.toggle("active");
    var panel = this.nextElementSibling;
    if (panel.style.maxHeight) {
      panel.style.maxHeight = null;
    } else {
      panel.style.maxHeight = panel.scrollHeight + "px";
    } 
  });
}
</script>

</body>
